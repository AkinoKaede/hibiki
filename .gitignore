**/xcuserdata/
*.xcuserstate
/ios/DerivedData/
*.xcresult/
*.xcarchive/
*.ipa
*.dSYM/

# Local Apple signing configuration and credentials
/ios/Local.xcconfig
/ios/*.local.xcconfig
*.p12
*.p8
*.mobileprovision
*.provisionprofile

# Release archives
/dist/
