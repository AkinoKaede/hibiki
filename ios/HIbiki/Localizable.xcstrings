            "value": "服务器地址"
          }
        }
      }
    },
    "Hostname": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机名"
          }
        }
      }
    },
    "Server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器"
          }
        }
      }
    },
    "Connect to your server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到服务器"
          }
        }
      }
    },
    "Could not connect to the server. Check the address and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到服务器，请检查地址后重试。"
          }
        }
      }
    },
    "Channel creation is managed by the server administrator. Ask for an initialization invitation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道由服务器管理员创建。请向管理员索取初始化邀请。"
          }
        }
      }
    },
    "Connect to the server to check channel creation policy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接服务器后可查看频道创建策略。"
          }
        }
      }
    },
    "Obtain the invitation and PSK separately from a trusted member. The invitation must use your configured server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请分别从受信任成员获取邀请和预共享密钥。邀请中的服务器地址须与当前配置一致。"
          }
        }
      }
    },
    "Disconnect from server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出服务器"
          }
        }
      }
    },
    "Disconnect from this server?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出当前服务器？"
          }
        }
      }
    },
    "This stops current requests and removes this device’s local pairing. You can then connect to another server. Security key registrations are kept. You will need to pair again, even with this server. Other members can remove the old device from their channels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将停止当前请求并清除本机配对，之后可连接其他服务器。安全密钥登记会保留。即使重新连接此服务器，也需要重新配对。其他成员可从频道中移除旧设备。"
          }
        }
      }
    },
    "Enter a valid server address, with or without wss:// or ws://.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的服务器地址，可省略wss://或ws://。"
          }
        }
      }
    }
  },
  "version": "1.1"
}
