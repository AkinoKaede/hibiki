      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB"
          }
        }
      }
    },
    "USB and Lightning connectors are supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持USB和Lightning接口。"
          }
        }
      }
    },
    "USB connection detected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到USB连接"
          }
        }
      }
    },
    "USB connection detected. Continue to enter the PIN.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到USB连接，继续输入PIN。"
          }
        }
      }
    },
