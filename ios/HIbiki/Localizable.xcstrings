{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Approve device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准设备"
          }
        }
      }
    },
    "Approved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准"
          }
        }
      }
    },
    "Authentication": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证"
          }
        }
      }
    },
    "Availability": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线时间"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Card disconnected or request canceled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡已断开或请求已取消。"
          }
        }
      }
    },
    "Card reader unavailable. Use a physical device and check permissions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读卡器不可用。请使用真机并检查权限。"
          }
        }
      }
    },
    "Channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道"
          }
        }
      }
    },
    "Channel ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道ID"
          }
        }
      }
    },
    "Channel PSK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道预共享密钥"
          }
        }
      }
    },
    "Channel name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道名称"
          }
        }
      }
    },
    "Channels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道"
          }
        }
      }
    },
    "Compare all 24 words and the request ID on the approving device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在审批设备上核对全部24个校验词及请求ID。"
          }
        }
      }
    },
    "Compare these words on an existing member device before approving.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批前，请在现有成员设备上核对这些校验词。"
          }
        }
      }
    },
    "Connect only the security key you want to use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只连接你要使用的安全密钥。"
          }
        }
      }
    },
    "Connect to your relay": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到服务器"
          }
        }
      }
    },
    "Connect your security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接安全密钥"
          }
        }
      }
    },
    "Connect your OpenPGP security key by USB or Lightning, or tap it using NFC.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过USB或Lightning连接OpenPGP安全密钥，或使用NFC轻触读卡。"
          }
        }
      }
    },
    "Connecting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中"
          }
        }
      }
    },
    "Connection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Copy PSK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制预共享密钥"
          }
        }
      }
    },
    "Create a channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建频道"
          }
        }
      }
    },
    "Create channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建频道"
          }
        }
      }
    },
    "Decryption": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密"
          }
        }
      }
    },
    "Device name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备名称"
          }
        }
      }
    },
    "Enter passwords and use your security key for GPG operations on your trusted computers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入口令，或使用安全密钥为受信任电脑上的GPG操作提供服务。"
          }
        }
      }
    },
    "Generate invitation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成邀请"
          }
        }
      }
    },
    "Get started": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "HIbiki connects while the app is open. Services are off until you enable them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HIbiki仅在应用打开时连接。各项服务默认关闭，由你主动启用。"
          }
        }
      }
    },
    "HIbiki request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HIbiki请求"
          }
        }
      }
    },
    "Hold your security key near the top of your iPhone until the operation finishes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将安全密钥靠近iPhone顶部，直到操作完成。"
          }
        }
      }
    },
    "I compared all 24 words and the request ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核对全部24个校验词及请求ID"
          }
        }
      }
    },
    "Invalid card response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡返回了无效响应。"
          }
        }
      }
    },
    "Invitation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请"
          }
        }
      }
    },
    "Join a channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入频道"
          }
        }
      }
    },
    "Join a trusted device’s channel, or create your own.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入受信任设备的频道，或创建你自己的频道。"
          }
        }
      }
    },
    "Join channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入频道"
          }
        }
      }
    },
    "Joining device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请设备"
          }
        }
      }
    },
    "Keep HIbiki open to receive requests. Returning reconnects and accepts requests still waiting for this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持HIbiki打开以接收请求。返回应用后会重新连接，并接收仍在等待这台设备的请求。"
          }
        }
      }
    },
    "Leave channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出频道"
          }
        }
      }
    },
    "Leave this channel?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出该频道？"
          }
        }
      }
    },
    "Member": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员"
          }
        }
      }
    },
    "Members": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员"
          }
        }
      }
    },
    "NFC: tap once to register public information. For signing or decryption, enter the PIN first, then tap the same security key again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC：轻触一次以注册公开信息。之后签名或解密时，先输入PIN，再轻触同一把安全密钥。"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "No USB card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接USB安全密钥"
          }
        }
      }
    },
    "No channels yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无频道"
          }
        }
      }
    },
    "No keys on this card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡中没有密钥"
          }
        }
      }
    },
    "No pending requests": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无待审批请求"
          }
        }
      }
    },
    "Not an active member": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前不是成员"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Obtain the invitation and PSK separately from a trusted member. The invitation must use your configured relay.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请分别从受信任成员获取邀请和预共享密钥。邀请中的服务器地址须与当前配置一致。"
          }
        }
      }
    },
    "Offline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线"
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线"
          }
        }
      }
    },
    "OpenPGP card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenPGP卡"
          }
        }
      }
    },
    "OpenPGP keys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenPGP密钥"
          }
        }
      }
    },
    "PIN or passphrase": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN或口令"
          }
        }
      }
    },
    "PINs are not saved. Private keys stay on the card or the requesting computer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保存PIN。私钥留在卡中或发起请求的电脑上。"
          }
        }
      }
    },
    "Password entry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令输入"
          }
        }
      }
    },
    "Pending requests": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待审批请求"
          }
        }
      }
    },
    "Pending requests will be invalidated. Approved members retain access.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待审批请求将失效，已批准成员仍保留访问权限。"
          }
        }
      }
    },
    "Pre-shared key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预共享密钥"
          }
        }
      }
    },
    "Present one OpenPGP security key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只靠近一把OpenPGP安全密钥。"
          }
        }
      }
    },
    "Private keys remain on your security key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥始终留在安全密钥中。"
          }
        }
      }
    },
    "Protocol": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协议"
          }
        }
      }
    },
    "Provide services": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供服务"
          }
        }
      }
    },
    "Public-key verification words": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公钥校验词"
          }
        }
      }
    },
    "Register NFC security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册NFC安全密钥"
          }
        }
      }
    },
    "Register USB security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册USB安全密钥"
          }
        }
      }
    },
    "Register your security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册你的安全密钥"
          }
        }
      }
    },
    "Register your security key in the Security Keys tab.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在安全密钥页面注册你的卡。"
          }
        }
      }
    },
    "Relay": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器"
          }
        }
      }
    },
    "Request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求"
          }
        }
      }
    },
    "Request ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求ID"
          }
        }
      }
    },
    "Request to join": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请加入"
          }
        }
      }
    },
    "Revoke": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        }
      }
    },
    "Revoke this device?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销此设备？"
          }
        }
      }
    },
    "Rotate PSK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮换预共享密钥"
          }
        }
      }
    },
    "Rotate channel PSK?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮换频道预共享密钥？"
          }
        }
      }
    },
    "Save your PSK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存预共享密钥"
          }
        }
      }
    },
    "Selected card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择的卡"
          }
        }
      }
    },
    "Serial number": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "序列号"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "Share invitation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享邀请"
          }
        }
      }
    },
    "Signing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "Store this PSK safely. Share it separately from the invitation; HIbiki does not save it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请妥善保存预共享密钥，并与邀请分开分享。HIbiki不会保存此密钥。"
          }
        }
      }
    },
    "The entries do not match.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次输入不一致。"
          }
        }
      }
    },
    "These words identify a public device key. They are not a recovery phrase.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些词用于标识设备公钥，不是恢复助记词。"
          }
        }
      }
    },
    "This device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机"
          }
        }
      }
    },
    "This identity will no longer be able to rejoin this channel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此身份将无法重新加入该频道。"
          }
        }
      }
    },
    "USB connection detected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到USB连接"
          }
        }
      }
    },
    "Unable to complete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成"
          }
        }
      }
    },
    "Verified requester": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证的请求方"
          }
        }
      }
    },
    "Waiting for approval": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待审批"
          }
        }
      }
    },
    "While app is open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用打开时"
          }
        }
      }
    },
    "Your keys stay with you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥，始终在你手中。"
          }
        }
      }
    },
    "Security Keys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全密钥"
          }
        }
      }
    },
    "Confirmation required for each operation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次操作前询问"
          }
        }
      }
    },
    "Insert your security key, then continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请插入你的安全密钥，然后继续。"
          }
        }
      }
    },
    "Use your security key for this operation? Enter the PIN next, then tap the key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的安全密钥完成本次操作？继续后先输入PIN，再轻触安全密钥。"
          }
        }
      }
    },
    "USB reader reports a card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB读卡器检测到卡"
          }
        }
      }
    },
    "Registered security keys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已注册的安全密钥"
          }
        }
      }
    },
    "No security keys registered": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未注册安全密钥"
          }
        }
      }
    },
    "Register once to save public information. Private keys stay on your security key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册后保存公开信息，私钥始终留在安全密钥中。"
          }
        }
      }
    },
    "One entry per security key. USB and NFC connections share the same public information. Only the selected key provides card services.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张卡只显示一条记录，USB和NFC共用公开信息。只有当前选中的卡提供卡服务。"
          }
        }
      }
    },
    "Security Key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全密钥"
          }
        }
      }
    },
    "Security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全密钥"
          }
        }
      }
    },
    "Read using": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取方式"
          }
        }
      }
    },
    "NFC support": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC支持"
          }
        }
      }
    },
    "USB connection support": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB支持"
          }
        }
      }
    },
    "Turn this off if your key does not support the other connection. Registration reads only the current connection; identity is checked again during use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果卡不支持另一种连接方式，请关闭此开关。注册只读取当前连接，实际使用时会再次核对卡身份。"
          }
        }
      }
    },
    "Read and register": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取并注册"
          }
        }
      }
    },
    "Insert the security key to read its public information. No PIN is required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请插入安全密钥以读取公开信息，无需PIN。"
          }
        }
      }
    },
    "Tap your security key to read its public information. No PIN is required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请轻触安全密钥以读取公开信息，无需PIN。"
