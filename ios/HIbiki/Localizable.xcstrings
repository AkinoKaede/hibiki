          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        }
      }
    },
    "Approve device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准设备"
          }
        }
      }
    },
    "Approved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准"
          }
        }
      }
    },
    "Authentication": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证"
          }
        }
      }
    },
    "Availability": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线时间"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Card disconnected or request canceled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡已断开或请求已取消。"
          }
        }
      }
    },
    "Card reader unavailable. Use a physical device and check permissions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读卡器不可用。请使用真机并检查权限。"
          }
        }
      }
    },
    "Channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道"
          }
        }
      }
    },
    "Channel actions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道操作"
          }
        }
      }
    },
    "Channel ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道ID"
          }
        }
      }
    },
    "Channel name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道名称"
          }
        }
      }
    },
    "Channel PSK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道预共享密钥"
          }
        }
      }
    },
    "Channels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道"
          }
        }
      }
    },
    "Compare all 24 words and the request ID on the approving device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在审批设备上核对全部24个校验词及请求ID。"
          }
        }
      }
    },
    "Compare these words on an existing member device before approving.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批前，请在现有成员设备上核对这些校验词。"
          }
        }
      }
    },
    "Confirmation required for each operation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次操作前询问"
          }
        }
      }
    },
    "Connect only the security key you want to use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只连接你要使用的安全密钥。"
          }
        }
      }
    },
    "Connect using USB, or enter the PIN and use NFC.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可现场连接USB，或输入PIN后使用NFC。"
          }
        }
      }
    },
    "Connect your OpenPGP security key by USB or Lightning, or tap it using NFC.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过USB或Lightning连接OpenPGP安全密钥，或使用NFC轻触读卡。"
          }
        }
      }
    },
    "Connect your security key": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接安全密钥"
          }
        }
      }
    },
    "Connecting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中"
          }
        }
      }
    },
    "Connection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Copy PSK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制预共享密钥"
          }
        }
      }
    },
    "Create a channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建频道"
          }
        }
      }
    },
    "Create channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建频道"
          }
        }
      }
    },
    "Decryption": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密"
          }
        }
      }
    },
    "Disconnect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出"
          }
        }
      }
    },
    "Enter passwords and use your security key for GPG operations on your trusted computers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入口令，或使用安全密钥为受信任电脑上的GPG操作提供服务。"
          }
        }
      }
    },
    "Enter the PIN, then tap your security key using NFC.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入PIN后，通过NFC轻触安全密钥。"
          }
        }
      }
    },
    "Finish setup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成设置"
          }
        }
      }
    },
    "Generate invitation": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成邀请"
          }
        }
      }
    },
    "Get started": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "HIbiki": {
      "comment": "The app name.",
      "isCommentAutoGenerated": true
    },
    "HIbiki connects while the app is open. Services are off until you enable them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HIbiki仅在应用打开时连接。各项服务默认关闭，由你主动启用。"
          }
        }
      }
    },
    "HIbiki request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HIbiki请求"
          }
        }
      }
    },
    "hibiki-v1:…": {
      "comment": "A placeholder text for the invitation code.",
      "isCommentAutoGenerated": true
    },
    "Hold your security key near the top of your iPhone until the operation finishes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将安全密钥靠近iPhone顶部，直到操作完成。"
          }
        }
      }
    },
    "I compared all 24 words and the request ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核对全部24个校验词及请求ID"
          }
        }
      }
    },
    "Insert the security key to read its public information. No PIN is required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请插入安全密钥以读取公开信息，无需PIN。"
          }
        }
      }
    },
    "Insert your security key, then continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请插入你的安全密钥，然后继续。"
          }
        }
      }
    },
    "Invalid card response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡返回了无效响应。"
          }
        }
      }
    },
    "Invitation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请"
          }
        }
      }
    },
    "Invite device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请"
          }
        }
      }
    },
    "Join a channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入频道"
          }
        }
      }
    },
    "Join a channel in the Channels tab, then enable the services you want this device to provide.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“频道”页加入频道，然后启用你希望此设备提供的服务。"
          }
        }
      }
    },
    "Join a channel using an invitation from its administrator or a trusted member.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用管理员或可信成员提供的邀请加入频道。"
          }
        }
      }
    },
    "Join a trusted device’s channel, or create your own.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入受信任设备的频道，或创建你自己的频道。"
          }
        }
      }
    },
    "Join channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入频道"
          }
        }
      }
    },
    "Joining device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请设备"
          }
        }
      }
    },
    "Keep HIbiki open to receive requests. Returning reconnects and accepts requests still waiting for this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持HIbiki打开以接收请求。返回应用后会重新连接，并接收仍在等待这台设备的请求。"
          }
        }
      }
    },
    "Leave channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出频道"
          }
        }
      }
    },
    "Leave this channel?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出该频道？"
          }
        }
      }
    },
    "Member": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员"
          }
        }
      }
    },
    "Members": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "NFC support": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC支持"
          }
        }
      }
    },
    "NFC: tap once to register public information. For signing or decryption, enter the PIN first, then tap the same security key again.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC：轻触一次以注册公开信息。之后签名或解密时，先输入PIN，再轻触同一把安全密钥。"
          }
        }
      }
    },
    "No channels yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无频道"
          }
        }
      }
    },
    "No keys on this card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡中没有密钥"
          }
        }
      }
    },
    "No pending requests": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无待审批请求"
          }
        }
      }
    },
    "No security keys registered": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未注册安全密钥"
          }
        }
      }
    },
    "No USB card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接USB安全密钥"
          }
        }
      }
    },
    "Not an active member": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前不是成员"
          }
        }
      }
    },
    "Offline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "One entry per security key. USB and NFC connections share the same public information. Only the selected key provides card services.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张卡只显示一条记录，USB和NFC共用公开信息。只有当前选中的卡提供卡服务。"
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在线"
          }
        }
      }
    },
    "Only removes this app’s public record. It does not erase keys from the security key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只移除本应用保存的公开记录，不会删除卡上的密钥。"
          }
        }
      }
    },
    "OpenPGP card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenPGP卡"
          }
        }
      }
    },
    "OpenPGP keys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenPGP密钥"
          }
        }
      }
    },
    "Password entry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令输入"
          }
        }
      }
    },
    "Pending requests": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待审批请求"
          }
        }
      }
    },
    "Pending requests will be invalidated. Approved members retain access.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待审批请求将失效，已批准成员仍保留访问权限。"
          }
        }
      }
    },
    "PIN or passphrase": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN或口令"
          }
        }
      }
    },
    "PINs are not saved. Private keys stay on the card or the requesting computer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保存PIN。私钥留在卡中或发起请求的电脑上。"
          }
        }
      }
    },
    "Pre-shared key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预共享密钥"
          }
        }
      }
    },
    "Present one OpenPGP security key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只靠近一把OpenPGP安全密钥。"
          }
        }
      }
    },
    "Private keys remain on your security key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥始终留在安全密钥中。"
          }
        }
      }
    },
    "Protocol": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协议"
          }
        }
      }
    },
    "Provide services": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供服务"
          }
        }
      }
    },
    "Public-key verification words": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公钥校验词"
          }
        }
      }
    },
    "Read and register": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取并注册"
          }
        }
      }
    },
    "Read using": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取方式"
          }
        }
      }
    },
    "Register NFC security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册NFC安全密钥"
          }
        }
      }
    },
    "Register once to save public information. Private keys stay on your security key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册后保存公开信息，私钥始终留在安全密钥中。"
          }
        }
      }
    },
    "Register security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册安全密钥"
          }
        }
      }
    },
    "Register USB security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册USB安全密钥"
          }
        }
      }
    },
    "Register your security key": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册你的安全密钥"
          }
        }
      }
    },
    "Register your security key in the Security Keys tab.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在安全密钥页面注册你的卡。"
          }
        }
      }
    },
    "Registered security keys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已注册的安全密钥"
          }
        }
      }
    },
    "Registration read using": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册读取方式"
          }
        }
      }
    },
    "Reject request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝申请"
          }
        }
      }
    },
    "Reject this join request?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝此加入申请？"
          }
        }
      }
    },
    "Rejected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝"
          }
        }
      }
    },
    "Remove registration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除注册"
          }
        }
      }
