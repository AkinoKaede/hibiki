            "state": "translated",
            "value": "签名"
          }
        }
      }
    },
    "Skip TLS Certificate Validation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过TLS证书校验"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "Store this PSK safely. Share it separately from the invitation; HIbiki does not save it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请妥善保存预共享密钥，并与邀请分开分享。HIbiki不会保存此密钥。"
          }
        }
      }
    },
    "Supported connections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的连接方式"
          }
        }
      }
    },
    "Tap your security key to read its public information. No PIN is required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请轻触安全密钥以读取公开信息，无需PIN。"
          }
        }
      }
    },
    "The entries do not match.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次输入不一致。"
          }
        }
      }
    },
    "The join request was rejected, withdrawn, or invalidated. Obtain a current invitation to try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入申请已被拒绝、撤回或失效。请获取有效邀请后重试。"
          }
        }
      }
    },
    "These words identify a public device key. They are not a recovery phrase.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些词用于标识设备公钥，不是恢复助记词。"
          }
        }
      }
    },
    "This device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机"
          }
        }
      }
    },
    "This identity will no longer be able to rejoin this channel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此身份将无法重新加入该频道。"
          }
        }
      }
    },
    "This removes only this request. The device may request to join again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作仅移除此申请。该设备之后仍可重新申请加入。"
          }
        }
      }
    },
    "This request stays pending until approved or invalidated.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求会保留，直到获得批准或失效。"
          }
        }
      }
    },
    "This request stays pending until approved, rejected, withdrawn, or invalidated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此申请会保持等待状态，直到被批准、拒绝、撤回或失效。"
          }
        }
      }
    },
    "Turn this off if your key does not support the other connection. Registration reads only the current connection; identity is checked again during use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果卡不支持另一种连接方式，请关闭此开关。注册只读取当前连接，实际使用时会再次核对卡身份。"
          }
        }
      }
    },
    "Unable to complete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成"
          }
        }
      }
    },
