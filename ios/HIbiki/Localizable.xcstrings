      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB支持"
          }
        }
      }
    },
    "USB reader reports a card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB读卡器检测到卡"
          }
        }
      }
    },
    "Use this security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用这张安全密钥"
          }
        }
      }
    },
    "Use your security key for this operation? Enter the PIN next, then tap the key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的安全密钥完成本次操作？继续后先输入PIN，再轻触安全密钥。"
          }
        }
      }
    },
    "Verified requester": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证的请求方"
          }
        }
      }
    },
    "Waiting for approval": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待审批"
          }
        }
      }
    },
    "While app is open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用打开时"
          }
        }
      }
    },
