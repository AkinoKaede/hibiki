            "state": "translated",
            "value": "核对撤销操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核對撤銷操作"
          }
        }
      }
    },
    "Revoked by Server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已被服务器撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已被伺服器撤銷"
          }
        }
      }
    },
    "Ancestor Revocation Available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可撤销上级的日期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可撤銷上級的日期"
          }
        }
      }
    },
    "You can revoke devices below you in the approval chain. After 30 days of your current membership, you can also revoke your approver or ancestors. Subtree removal is optional and applies only to descendants.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以撤销审批链中的下级设备。本次加入满30天后，也可以撤销审批者或更上级的设备。可选择撤销整个子树，此操作仅适用于下级分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以撤銷審批鏈中的下級裝置。本次加入滿30天後，也可以撤銷審批者或更上級的裝置。可選擇撤銷整個子樹，此操作僅適用於下級分支。"
          }
        }
      }
    },
    "Current RTT": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前往返延迟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前往返延遲"
          }
        }
      },
