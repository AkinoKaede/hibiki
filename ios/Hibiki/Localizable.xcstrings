    },
    "Continue with USB, or tap your key with NFC if no USB key is connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击继续使用USB；未连接USB密钥时将打开NFC扫描器。"
          }
        }
      }
    },
    "The invitation server does not match your configured server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请中的服务器与当前配置不一致。"
          }
        }
      }
    },
    "This invitation has expired. Ask a member for a new invitation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此邀请已过期，请向成员获取新邀请。"
          }
        }
      }
    },
    "This invitation format is no longer supported. Ask a member for a new invitation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此邀请格式已不再支持，请向成员获取新邀请。"
          }
        }
      }
    },
    "This verification code does not match the selected request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此核验码与所选申请不匹配。"
          }
        }
      }
    },
    "This request is no longer waiting for approval.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此申请已不再等待批准。"
          }
        }
      }
    },
    "This disconnects from the server, resets local pairing, and forgets the current NFC key. You will need to pair again to reconnect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开服务器连接、重置本地配对并清除当前NFC密钥记录。重新连接前需要再次配对。"
          }
        }
      }
    },
    "Add Channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加频道"
          }
        }
      }
    },
    "Create a channel or join one using an invitation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建频道或通过邀请加入频道。"
          }
        }
      }
    },
    "Connect to the server to create a channel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接服务器后即可创建频道。"
          }
        }
      }
    },
    "This server does not allow channel creation. Ask an administrator for an invitation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器不允许创建频道，请向管理员索取邀请。"
          }
        }
      }
    },
    "Information from the last successful USB read. Kept until new information is read.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示上次成功读取的USB信息，直到成功读取新信息后更新。"
          }
        }
      }
    },
    "Join this channel with a new invitation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用新邀请加入此频道。"
          }
        }
      }
    },
    "A device is requesting to join a channel. Open Hibiki to review.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有设备申请加入频道，请打开Hibiki审核。"
          }
        }
      }
    },
    "A password request needs your attention. Open Hibiki to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有密码请求需要处理，请打开Hibiki继续。"
          }
        }
      }
    },
    "A security key operation needs your attention. Open Hibiki to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有安全密钥操作需要处理，请打开Hibiki继续。"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "An operation has a message for you. Open Hibiki to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有操作消息需要查看，请打开Hibiki继续。"
          }
        }
      }
    },
    "An operation needs your confirmation. Open Hibiki to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有操作需要确认，请打开Hibiki继续。"
          }
        }
      }
    },
    "Background Requests": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台请求"
          }
        }
      }
    },
    "Hibiki keeps the connection while iOS allows background execution. Notifications require permission and cannot arrive after the app is suspended.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibiki会在iOS允许后台运行期间保持连接。通知需要获得授权，App被系统挂起后无法接收新请求通知。"
          }
        }
      }
    },
    "Not Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未允许"
          }
        }
      }
    },
    "Not Requested": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未请求"
          }
