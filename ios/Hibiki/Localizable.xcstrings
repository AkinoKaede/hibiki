        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用这张安全密钥"
          }
        }
      }
    },
    "Verified requester": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证的请求方"
          }
        }
      }
    },
    "Waiting for approval": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待审批"
          }
        }
      }
    },
    "While app is open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用打开时"
          }
        }
      }
    },
    "Withdraw request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回申请"
          }
        }
      }
    },
    "Withdraw this join request?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回此加入申请？"
          }
        }
      }
    },
    "Your keys stay with you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥，始终在你手中。"
          }
        }
      }
    },
    "Server URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器地址"
          }
        }
      }
    },
    "Hostname": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机名"
          }
        }
      }
    },
    "Server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器"
          }
        }
      }
    },
    "Connect to your server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到服务器"
          }
        }
      }
    },
    "Could not connect to the server. Check the address and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到服务器，请检查地址后重试。"
          }
        }
      }
    },
    "Disconnect from server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出服务器"
          }
        }
      }
    },
    "Disconnect from this server?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出当前服务器？"
          }
        }
      }
    },
    "Enter a valid server address, with or without wss:// or ws://.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的服务器地址，可省略wss://或ws://。"
          }
        }
      }
    },
    "Use your security key and enter passphrases for GPG operations on your computers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在受信任电脑上执行GPG操作时，在此输入口令或使用安全密钥。"
          }
        }
      }
    },
    "Join a channel in the Channels tab, then enable services for this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“频道”标签页加入频道，然后启用此设备所需的服务。"
          }
        }
      }
    },
    "Connect via USB, or enter the PIN and tap with NFC.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接USB，或输入PIN后轻触NFC。"
          }
        }
      }
    },
    "Enter your PIN, then tap your security key with NFC.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入PIN，然后轻触安全密钥。"
          }
        }
      }
    },
    "Compare these verification words on a member device before approving.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批前，请在现有成员设备上核对这些公钥校验词。"
          }
        }
      }
    },
    "This request stays pending until approved, rejected, or withdrawn.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求将保持等待状态，直到被批准、拒绝或撤回。"
          }
        }
      }
    },
    "Channel creation requires an invitation from the server administrator.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建频道需要服务器管理员提供的初始化邀请。"
          }
        }
      }
    },
    "Connect to the server to check channel creation permissions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接服务器后可检查频道创建权限。"
          }
        }
      }
    },
    "Get the invitation and PSK separately from a trusted member. The invitation server must match yours.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请向受信任成员索取邀请和预共享密钥。邀请对应的服务器地址必须与当前一致。"
          }
        }
      }
    },
    "Compare the 24 verification words and request ID on the approving device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在审批设备上核对全部24个校验词及请求ID。"
          }
        }
      }
    },
    "This device will not be able to rejoin this channel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备将被移除且无法重新加入此频道。"
          }
        }
      }
    },
    "I verified the 24 words and request ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核对24个校验词与请求ID"
          }
        }
      }
    },
    "These words verify this device’s public key. They are not a recovery phrase.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些校验词仅用于验证设备公钥，并非数据恢复助记词。"
          }
        }
      }
    },
    "Removes this request. The device can request to join again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除当前请求，该设备后续仍可重新申请。"
          }
        }
      }
    },
    "This join request was rejected or has expired. Get a new invitation to try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入申请已失效或被拒绝，请获取新邀请后重试。"
          }
        }
      }
    },
    "USB security key detected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检测到USB安全密钥"
          }
        }
      }
    },
    "No USB security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到USB安全密钥"
          }
        }
      }
    },
    "Register once to save public information. Private keys always stay on your security key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册仅保存公钥信息，私钥始终留在安全密钥硬件中。"
          }
        }
      }
    },
    "Selected security key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前选中的安全密钥"
          }
        }
      }
    },
    "USB and NFC share the same key record. Only the selected security key provides card services.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB与NFC共用公钥信息。仅当前选中的安全密钥提供卡服务。"
          }
        }
      }
    },
    "Turn this off if your key does not support both USB and NFC. Key identity is verified again during use.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若密钥不同时支持USB与NFC，请关闭此项。使用时会再次校验密钥身份。"
          }
        }
      }
    },
    "Insert your security key to read public information. No PIN needed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入安全密钥以读取公钥信息，无需输入PIN。"
          }
        }
      }
    },
    "Tap your security key to read public information. No PIN needed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻触安全密钥以读取公钥信息，无需输入PIN。"
          }
        }
      }
    },
    "No OpenPGP keys found on this key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该安全密钥中未发现OpenPGP密钥"
          }
        }
      }
    },
    "Only removes this app’s saved record. It does not erase keys from your security key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除本应用保存的公钥记录，不会抹掉安全密钥中的任何数据。"
          }
        }
      }
    },
    "PINs are never saved. Private keys stay on your security key or computer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用绝不保存PIN。私钥始终保存在安全密钥硬件或发起请求的电脑上。"
          }
        }
      }
    },
    "This disconnects from the server and resets local pairing. Registered security keys are kept, but you will need to pair again to reconnect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开连接将重置本机的服务器配对信息。已添加的安全密钥会保留，重新连接需再次配对。"
          }
        }
      }
    },
    "Security key reader is unavailable. Check permissions and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全密钥读取器不可用，请检查系统权限或在真机上运行。"
          }
        }
      }
    },
    "Security key disconnected or operation canceled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全密钥已断开或操作已取消。"
          }
        }
      }
    },
    "Invalid security key response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全密钥返回了无效响应。"
          }
        }
      }
    },
    "Hold only one OpenPGP security key near your iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只将一把OpenPGP安全密钥靠近iPhone。"
          }
        }
      }
    },
    "Use your security key for this operation? Enter your PIN, then tap the key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用安全密钥处理本次操作？请输入PIN，然后轻触安全密钥。"
          }
        }
      }
    },
    "Hibiki": {
      "comment": "The app name.",
      "isCommentAutoGenerated": true
    },
    "Hibiki request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibiki请求"
          }
        }
      }
    },
    "Hibiki connects while the app is open. Services remain off until enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibiki仅在应用打开时保持连接。各项服务默认处于关闭状态。"
          }
        }
      }
    },
    "Keep Hibiki open to receive requests. Returning to the app reconnects automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持Hibiki在前台以接收请求。切回应用时会自动重连并处理等待中的请求。"
          }
        }
      }
    },
    "Store this PSK safely and share it separately from the invitation. Hibiki does not save it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请妥善保管预共享密钥，并与邀请分开提供。Hibiki不会保存此密钥。"
          }
        }
      }
    }
  },
  "version": "1.1"
}