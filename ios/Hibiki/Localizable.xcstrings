    "USB and Lightning connectors are supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持USB和Lightning接口。"
          }
        }
      }
    },
    "Verified Requester": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
