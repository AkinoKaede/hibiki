      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回申请"
          }
        }
      }
    },
    "Withdraw this join request?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回此加入申请？"
          }
        }
      }
    },
    "Your keys stay with you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥，始终在你手中。"
          }
        }
      }
    },
    "Server URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器地址"
          }
        }
      }
    },
