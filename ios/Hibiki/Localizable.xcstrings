            "value": "通知"
          }
        }
      }
    },
    "Open Notification Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开通知设置"
          }
        }
      }
    },
    "Request Unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求不可用"
          }
        }
      }
    },
    "This request is no longer pending.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求已失效或处理完毕。"
