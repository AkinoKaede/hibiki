            "value": "名稱（留空則從卡片讀取）"
          }
        }
      }
    },
    "Rename Device": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新命名裝置"
          }
        }
      }
    },
    "Device Name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备名称"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置名稱"
          }
        }
      }
    },
    "Keys, device ID and verification words stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥、设备ID和验证词保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰、裝置ID與驗證詞保持不變。"
          }
        }
      }
    },
    "Measures encrypted round trips to this device through the relay. Connection setup is measured separately. No card or PIN is requested.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量经中继到此设备的加密往返延迟。连接建立耗时单独显示，不需要卡片或PIN。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測量經中繼到此裝置的加密往返延遲。連線建立时间分開顯示，不需要卡片或PIN。"
          }
        }
      }
    },
    "Get an invitation from a trusted member. Older invitations require a separate PSK. The invitation server must match yours.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从受信任的成员获取邀请。旧版邀请需要单独输入PSK。邀请中的服务器须与当前服务器一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向受信任的成員取得邀請。舊版邀請需要另外輸入PSK。邀請中的伺服器須與目前伺服器相同。"
          }
        }
      }
    },
    "Revoke %@ from %@?\n\nDevice ID: %@\n\nThis device will not be able to rejoin this channel.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将%@从%@中撤销吗？\n\n设备ID：%@\n\n该设备将无法重新加入此频道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要將%@從%@中撤銷嗎？\n\n裝置ID：%@\n\n此裝置將無法重新加入此頻道。"
          }
        }
      }
    },
    "Approved by": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准者"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批准者"
          }
        }
      }
    },
    "Approval Role": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批角色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准角色"
          }
        }
      }
    },
    "Channel Founder": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道创建者"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頻道建立者"
          }
        }
      }
    },
    "Outside Your Approval Branch": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不属于你的审批分支"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不屬於你的核准分支"
          }
        }
      }
    },
    "You can revoke only devices you approved, or devices they approved directly or indirectly. Revoking this device does not automatically revoke its descendants.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你只能撤销自己批准的设备，或由它们直接或间接批准的设备。撤销此设备不会自动撤销其下级设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你只能撤銷自己核准的裝置，或由它們直接或間接核准的裝置。撤銷此裝置不會自動撤銷其下級裝置。"
          }
        }
      }
    },
    "Revoke Entire Approval Subtree": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销整个审批子树"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷整個審批子樹"
          }
        }
      }
    },
    "Affected devices: %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受影响的设备：%lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受影響的裝置：%lld"
          }
        }
      }
    },
    "These identities will lose access and cannot rejoin this channel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些身份将失去访问权限，且无法重新加入此频道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些身分將失去存取權限，且無法重新加入此頻道。"
          }
        }
      }
    },
    "Confirm Revocation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認撤銷"
          }
        }
